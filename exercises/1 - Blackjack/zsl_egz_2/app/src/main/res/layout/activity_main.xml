<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1B5E20"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Komputer -->
        <TextView
            android:id="@+id/tvComputer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Komputer"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/compCard1"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:layout_margin="5dp"
                android:src="@drawable/rewers" />

            <ImageView
                android:id="@+id/compCard2"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:layout_margin="5dp"
                android:src="@drawable/rewers" />

            <ImageView
                android:id="@+id/compCard3"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:layout_margin="5dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/compCard4"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:layout_margin="5dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/compCard5"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:layout_margin="5dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCompSum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suma komputera: ?"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- Komunikaty -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20dp"
            android:gravity="center"
            android:text="Twoja kolej! Dobierz kartę lub pasuj."
            android:textColor="#FFEB3B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Gracz -->
        <TextView
            android:id="@+id/tvPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gracz"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/playerCard1"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:layout_margin="5dp" />

            <ImageView
                android:id="@+id/playerCard2"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:layout_margin="5dp" />

            <ImageView
                android:id="@+id/playerCard3"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:layout_margin="5dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/playerCard4"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:layout_margin="5dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/playerCard5"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:layout_margin="5dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPlayerSum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suma gracza: 0"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <!-- Przyciski -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDobierz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:backgroundTint="#2E7D32"
                android:text="DOBIERZ"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Button
                android:id="@+id/btnPass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:backgroundTint="#2E7D32"
                android:text="PASS"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnNowaGra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:backgroundTint="#2E7D32"
            android:text="NOWA GRA"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>